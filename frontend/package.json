{
  "name": "wails-angular-template",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve --configuration development --host 127.0.0.1",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:build": "BUILD_BEFORE_SERVE=1 playwright test",
    "test:wails": "playwright test --config=playwright.wails.config.ts",
    "serve:ssr:wails-angular-template": "node dist/wails-angular-template/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~21.2.12",
    "@angular/compiler": "~21.2.12",
    "@angular/core": "~21.2.12",
    "@angular/forms": "~21.2.12",
    "@angular/platform-browser": "~21.2.12",
    "@angular/platform-server": "~21.2.12",
    "@angular/router": "~21.2.12",
    "@angular/ssr": "^21.2.10",
    "@awesome.me/webawesome-pro": "file:../../../vendor-pro/webawesome/webawesome-zip",
    "@ctrl/tinycolor": "^4.1.0",
    "@floating-ui/dom": "^1.7.6",
    "@fortawesome/fontawesome-pro-web": "file:../../../vendor-pro/fontawesome-web/fontawesome-pro-plus-7.2.0-web",
    "@lit/react": "^1.0.8",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@shoelace-style/animations": "^1.2.0",
    "@shoelace-style/localize": "^3.2.2",
    "@tailwindcss/postcss": "^4.3.0",
    "@wailsio/runtime": "^3.0.0-alpha.79",
    "composed-offset-position": "^0.0.6",
    "express": "^5.1.0",
    "highlight.js": "^11.11.1",
    "lit": "^3.3.2",
    "marked": "^18.0.3",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.1.11",
    "qr-creator": "^1.0.0",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "~21.2.12",
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "serve": "^14.2.6",
    "typescript": "~5.9.2"
  }
}
